# MongoDB Connection URI (e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/reelix)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/reelix

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Inngest Background Jobs Configuration
INGEST_EVENT=your_inngest_event_key
INGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key
INNGEST_DEV=0

# The Movie Database (TMDB) API Key
TMDB_API_KEY=your_tmdb_api_key_here
