# ==============================================================================
# Environment Variables & Secrets (CRITICAL - Keeps MongoDB URI & API Keys safe)
# ==============================================================================
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Server & Client specific environment files
server/.env
server/.env.*
client/.env
client/.env.*

# Allow committing sample/template env files
!.env.example
!*.env.example
!server/.env.example
!client/.env.example

# Private Keys, Certificates & Database Dumps
*.pem
*.key
*.cert
*.crt
mongod.lock
dump/
*.dump

# ==============================================================================
# Dependencies
# ==============================================================================
node_modules/
*/node_modules/
jspm_packages/
.pnp
.pnp.js

# ==============================================================================
# Production & Distribution Builds
# ==============================================================================
dist/
dist-ssr/
build/
out/
client/dist/
client/dist-ssr/
client/build/
*.tsbuildinfo

# ==============================================================================
# Logs & Process Outputs
# ==============================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Operating System Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ==============================================================================
# IDE & Editor Directories
# ==============================================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# ==============================================================================
# Caches & Temporary Files
# ==============================================================================
.cache/
.parcel-cache/
.eslintcache
.vite/
*.tmp
*.temp
